# Required: LLM provider (pick one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: pin a different model for the expense adjudicator (defaults to OPENAI_MODEL)
# ADJUDICATOR_MODEL=gpt-4o-mini

# Or local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Script knobs (optional)
# DEMO_EMAIL_COUNT=100
# THEMES_EMAIL_COUNT=1200
# THEMES_CONCURRENCY=8
