# Required: LLM provider (pick one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Ledgerline Adjudicator uses its own model pin (do not reuse OPENAI_MODEL).
ADJUDICATOR_MODEL=gpt-5.6

# Or local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional: Braintrust tracing (https://www.braintrust.dev/)
# BRAINTRUST_API_KEY=sk-...
# BRAINTRUST_API_URL=https://api.braintrust.dev
# EU: https://api-eu.braintrust.dev
# BRAINTRUST_PROJECT=My Project
# BRAINTRUST_PROJECT_ID=b9a5698f-8159-4af9-bb06-844496357d5f
# BRAINTRUST_TRACING=false

# Optional: Langfuse tracing (https://cloud.langfuse.com/)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_TRACING_ENABLED=false

# Optional: Galileo tracing (https://app.galileo.ai/)
# GALILEO_API_KEY=your-galileo-api-key
# GALILEO_PROJECT=demo app
# GALILEO_LOG_STREAM=demo app
# Custom Galileo deployments only (omit for app.galileo.ai):
# GALILEO_CONSOLE_URL=https://console.galileo.yourcompany.com
# GALILEO_LOGGING_DISABLED=true

# Optional: LangSmith tracing (https://smith.langchain.com/)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=ledgerline
# EU region (required if you signed up at eu.smith.langchain.com; omit for US):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=  # only needed for org-scoped keys
# Short scripts: flush before exit (configure_tracing also setdefaults this)
# LANGCHAIN_CALLBACKS_BACKGROUND=false

# Script knobs (optional)
# DEMO_EMAIL_COUNT=100
# THEMES_EMAIL_COUNT=1200
# THEMES_CONCURRENCY=8
