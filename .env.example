# Required: LLM provider (pick one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Or local Ollama instead of OpenAI
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Required for Gmail read-only OAuth (local)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Encrypts the local session cookie (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Script knobs (optional)
# DEMO_EMAIL_COUNT=100
# THEMES_EMAIL_COUNT=1200
# THEMES_CONCURRENCY=8

# Langfuse tracing (optional but recommended)
# Create keys in Langfuse: Settings → API Keys (https://cloud.langfuse.com)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com | JP: https://jp.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
